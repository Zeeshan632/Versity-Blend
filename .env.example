# Server
PORT=3000

# Auth / JWT
ACCESS_TOKEN_SECRET=your_super_secret_key_here_change_this   # e.g. a long random string like: s3cr3tK3y!xZ9#mQ
ACCESS_TOKEN_EXPIRATION=3600s                                 # e.g. 60s, 15m, 1h, 7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_change_this  # e.g. another long random string like: r3fr3shS3
REFRESH_TOKEN_EXPIRATION=30d                                # e.g. 7d, 30d, 60d

# Database
DB_TYPE=postgres        # e.g. postgres, mysql, sqlite, mariadb
DB_HOST=localhost       # e.g. 127.0.0.1 or db.example.com
DB_PORT=5432            # e.g. 5432 (postgres), 3306 (mysql)
DB_USERNAME=admin       # e.g. root, postgres, myuser
DB_PASSWORD=password123 # e.g. str0ngP@ssw0rd!
DB_NAME=myapp_db        # e.g. development_db, myproject